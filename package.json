{
  "name": "hawaiian-rummy",
  "version": "2.0.0",
  "description": "Hawaiian Rummy card game",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "node --import tsx server/index.ts",
    "start:old": "node server.js",
    "build": "tsc -p tsconfig.server.json",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "start:pm2": "pm2 start ecosystem.config.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "nanoid": "^5.1.6",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
